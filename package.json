{
  "name": "nut-ai",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Nut AI — an open-source AI photo calorie tracker that never shows a number it cannot justify.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "eval",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && npm --prefix apps/mobile run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:node-purity": "node scripts/check-node-purity.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:node-purity && npm run data:verify && npm run ifct:verify && npm run indian-dishes:verify",
    "data:build": "node tools/nutrition-data/src/build.mjs",
    "data:verify": "node tools/nutrition-data/src/golden-queries.mjs",
    "ifct:build": "npm --workspace @nutai/ifct-import run build",
    "ifct:extract": "npm --workspace @nutai/ifct-import run extract",
    "ifct:verify": "npm --workspace @nutai/ifct-import run verify",
    "indian-dishes:map": "node tools/indian-dishes/map-ingredients.mjs",
    "indian-dishes:build": "node tools/indian-dishes/build-sqlite.mjs",
    "indian-dishes:verify": "node tools/indian-dishes/validate.mjs",
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "better-sqlite3": "^13.0.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true,
    "better-sqlite3@11.10.0": true
  }
}
