node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Expo
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.ipa
*.apk
*.aab

# Built data artifact — produced by nutai-nutrition-data, never committed here.
# It is ODbL-licensed and lives on its own release cadence (PLAN.md D6/D8).
apps/mobile/assets/nutrition.db
apps/mobile/assets/nutrition.db-*

# Path B model weights — large binaries, fetched at build time
apps/mobile/src/inference/pathB/models/*.pte
apps/mobile/src/inference/pathB/models/*.tflite

# NEVER commit. Keys live only in expo-secure-store, written from runtime user
# input. PLAN.md §4.4: never from EXPO_PUBLIC_*, app.json, .env, or EAS secrets.
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.keystore

# The CI upload key is the ONE deliberate exception (owner QA 2026-10):
# v0.1.0 shipped with an ephemeral CI debug key, which made every later build
# uninstall-only. A stable, committed CI key keeps the public Release APKs
# upgrade-safe forever. It guards nothing secret (a personal offline tracker,
# no server, no provider keys) and the REAL release keystore stays outside the
# repo — local builds keep using NUTAI_UPLOAD_* from ~/.gradle.
!apps/mobile/ci/ci-upload.keystore

# Golden set / eval working data — lives in its own repo (CC BY 4.0), and the
# non-commercial supplements (NutritionVerse, FPB, MetaFood3D) must NEVER be
# redistributed from here. See PLAN-ADDENDUM-2026-07-31.md §3.3.
eval/data/
eval/reports/
eval/.promptfoo/

.DS_Store
*.log

# Raw USDA source CSVs — re-downloadable, ~90MB unpacked.
tools/nutrition-data/data/

# Temporary testing scripts, dumps, and test screenshots
/*.png
/run_*.py
/test-*.js
/test_*.js
/window_dump.xml
/walkthrough.md

# Compiled artifacts of src/data/backup-core.ts — the bundler resolves the .ts;
# a stale .js beside it is a two-sources-of-truth trap (QA P2-31/P2-3).
apps/mobile/src/data/backup-core.js
apps/mobile/src/data/backup-core.js.map
apps/mobile/src/data/backup-core.d.ts.map
